# Ключ App Store Connect API.
# Где взять: App Store Connect -> Users and Access -> Integrations -> App Store Connect API
#   1) создайте ключ с ролью App Manager
#   2) скачайте файл AuthKey_XXXXXXXXXX.p8 (он даётся ОДИН раз)
#   3) положите его в ios/fastlane/private_keys/ — эта папка в .gitignore
#
# Скопируйте этот файл в ios/fastlane/.env и подставьте свои значения.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_FILEPATH=fastlane/private_keys/AuthKey_XXXXXXXXXX.p8

# Пропустить подпись на этапе flutter build (gym всё равно подписывает заново).
# Раскомментируйте, если хотите ускорить сборку.
# FLUTTER_BUILD_NO_CODESIGN=1
